\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sharpe ratios across construction choices. Ridge plots show the distribution of annualized Sharpe ratios of long-short return differentials for each sorting variable across all \texttt  {r\ .QuartoInlineRender(nrow(portfolio\_sort\_grid))} specifications illustrated in Table~\ref {tbl-sorting-decisions}, based on the available sample period per factor. Most variables exhibit substantial variation across specifications, underscoring the sensitivity of factor returns to construction choices.}}{20}{figure.caption.21}\protected@file@percent }
\newlabel{fig-sharpe-ratio}{{5}{20}{Sharpe ratios across construction choices. Ridge plots show the distribution of annualized Sharpe ratios of long-short return differentials for each sorting variable across all \texttt {r\ .QuartoInlineRender(nrow(portfolio\_sort\_grid))} specifications illustrated in Table~\ref {tbl-sorting-decisions}, based on the available sample period per factor. Most variables exhibit substantial variation across specifications, underscoring the sensitivity of factor returns to construction choices}{figure.caption.21}{}}
